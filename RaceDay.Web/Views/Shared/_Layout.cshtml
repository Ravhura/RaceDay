@{
    var role = Context.Session.GetString(SessionKeys.Role);
    var fullName = Context.Session.GetString(SessionKeys.FullName);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark rd-navbar">
            <div class="container">
                <a class="navbar-brand rd-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-lightning-charge-fill"></i> RaceDay
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        @if (role == Roles.Participant)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-calendar-event"></i> Events</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="Enrolments"><i class="bi bi-ticket-perforated"></i> My Enrolments</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="Results"><i class="bi bi-trophy"></i> My Results</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="Profile"><i class="bi bi-person-circle"></i> Profile</a></li>
                        }
                        else if (role == Roles.Organiser)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="ManageEvents" asp-action="Index"><i class="bi bi-flag"></i> My Events</a></li>
                        }
                    </ul>
                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        @if (role != null)
                        {
                            <li class="nav-item">
                                <span class="navbar-text me-3">@fullName <span class="badge rd-role-badge">@role</span></span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-light btn-sm"><i class="bi bi-box-arrow-right"></i> Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Log in</a></li>
                            <li class="nav-item"><a class="btn btn-rd btn-sm ms-lg-2" asp-controller="Account" asp-action="Register">Register</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container py-4">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="rd-footer">
        <div class="container">&copy; @DateTime.Now.Year RaceDay &middot; Road running, walking and cycling events across South Africa</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
@model ResultFormViewModel
@{
    ViewData["Title"] = Model.ResultId > 0 ? "Edit result" : "Enter result";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="rd-card p-4">
            <h2 class="rd-page-title mb-1">@(Model.ResultId > 0 ? "Edit result" : "Enter result")</h2>
            <p class="text-muted mb-4"><strong>@Model.ParticipantName</strong> &middot; @Model.CategoryName</p>

            <form asp-action="Edit" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <input type="hidden" asp-for="EventId" />
                <input type="hidden" asp-for="EnrolmentId" />
                <input type="hidden" asp-for="ResultId" />
                <input type="hidden" asp-for="ParticipantName" />
                <input type="hidden" asp-for="CategoryName" />

                <div class="mb-3">
                    <label asp-for="FinishTime" class="form-label"></label>
                    <input asp-for="FinishTime" class="form-control" placeholder="00:52:30" />
                    <span asp-validation-for="FinishTime" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Position" class="form-label"></label>
                    <input asp-for="Position" type="number" min="1" class="form-control" />
                    <span asp-validation-for="Position" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-rd">Save result</button>
                    <a asp-action="Index" asp-route-eventId="@Model.EventId" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
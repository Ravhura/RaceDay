@model EventFormViewModel
@{
    ViewData["Title"] = "Create event";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="rd-card p-4">
            <h2 class="rd-page-title">Create an event</h2>
            <form asp-action="Create" method="post" enctype="multipart/form-data" novalidate>
                <partial name="_EventForm" model="Model" />
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-rd">Create event</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
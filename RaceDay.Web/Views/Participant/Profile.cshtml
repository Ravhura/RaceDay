@model ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="rd-card p-4">
            <h2 class="rd-page-title mb-1">My profile</h2>
            <p class="text-muted">Member since @Model.MemberSince</p>

            <form asp-action="Profile" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="MemberSince" />

                <div class="mb-3">
                    <label class="form-label">Email address</label>
                    <input type="text" class="form-control" value="@Model.Email" disabled />
                    <div class="form-text">Your email is your login, so it cannot be changed here.</div>
                </div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PhoneNumber" class="form-label"></label>
                    <input asp-for="PhoneNumber" class="form-control" placeholder="For example: 082 123 4567" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-rd">Save changes</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
@model List<MyResultRow>
@{
    ViewData["Title"] = "My Results";
}

<h1 class="rd-page-title mb-1">My Results</h1>
<p class="text-muted mb-3">Your race history across the events you have completed. Results appear as soon as the organiser captures them.</p>

@if (!Model.Any())
{
    <div class="rd-card rd-empty">
        <i class="bi bi-trophy"></i>
        <p class="mt-2 mb-3">No completed events yet. Once you have raced, your times and positions will show here.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-rd">Find an event</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table rd-table mb-0">
            <thead>
                <tr><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Position</th></tr>
            </thead>
            <tbody>
                @foreach (var row in Model)
                {
                    var date = row.Event?.EventDate ?? row.Result?.EventDate;
                    <tr>
                        <td>
                            <a asp-controller="Events" asp-action="Details" asp-route-id="@row.Enrolment.EventId" class="fw-semibold text-decoration-none">@row.Enrolment.EventName</a>
                        </td>
                        <td>@(date.HasValue ? Format.Date(date.Value) : "-")</td>
                        <td>@row.Enrolment.CategoryName</td>
                        @if (row.Result != null)
                        {
                            <td class="fw-semibold">@Format.Time(row.Result.FinishTime)</td>
                            <td>
                                @if (row.Result.Position is >= 1 and <= 3)
                                {
                                    <i class="bi bi-trophy-fill rd-medal"></i>
                                }
                                <span class="rd-position">@Format.Ordinal(row.Result.Position)</span>
                                <span class="text-muted">of @row.Result.TotalFinishers finisher@(row.Result.TotalFinishers == 1 ? "" : "s")</span>
                            </td>
                        }
                        else
                        {
                            <td colspan="2"><span class="text-muted"><i class="bi bi-hourglass-split"></i> Awaiting result</span></td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
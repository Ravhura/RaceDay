@{
    ViewData["Title"] = "Home";
    var name = Context.Session.GetString(SessionKeys.FullName);
    var role = Context.Session.GetString(SessionKeys.Role);
}

<div class="rd-hero">
    <h1>Welcome, @name</h1>
    <p class="mb-0">You are logged in as <span class="badge rd-role-badge">@role</span>. Your pages are being built, so check back after the next step.</p>
</div>